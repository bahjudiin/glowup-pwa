{
  "name": "glowup",
  "version": "1.0.0",
  "private": true,
  "description": "GlowUp — mobile-first, PWA-installable static site generated from the Men's Transformation Research Library (Markdown files 00–27).",
  "scripts": {
    "extract": "node scripts/run-python.mjs extract.py",
    "build:art": "node scripts/run-python.mjs art.py",
    "build:data": "node scripts/build-data.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/app.css --minify",
    "build": "npm run build:art && npm run extract && npm run build:data && npm run build:css",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/app.css --watch",
    "serve": "node scripts/run-python.mjs -m http.server 8080 --bind 127.0.0.1",
    "test": "node dev/pwa-test.js",
    "build:standalone": "node scripts/run-python.mjs build_standalone.py",
    "build:all": "npm run build && npm run build:standalone",
    "usda:cache": "node scripts/build-usda-cache.cjs",
    "test:e2e": "node scripts/verify-app.mjs",
    "test:all": "npm run test && npm run test:queries && npm run test:standalone && npm run test:e2e && npm run test:design && npm run test:docs",
    "test:design": "node scripts/verify-design.mjs",
    "shots:design": "node scripts/shots-design.mjs",
    "fonts": "node scripts/fetch-fonts.mjs .",
    "shots:docs": "node scripts/shots-docs.mjs",
    "count": "node scripts/count-content.mjs",
    "test:docs": "node scripts/verify-docs.mjs",
    "test:queries": "node scripts/check-queries.mjs",
    "test:standalone": "node dev/standalone-test.js"
  },
  "devDependencies": {
    "playwright-core": "^1.47.2",
    "tailwindcss": "^3.4.14"
  }
}
